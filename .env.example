# ============================================================
#  Monitoring Listrik – Environment Variables Template
#  Salin file ini menjadi .env dan sesuaikan nilainya.
#  JANGAN commit file .env ke Git!
# ============================================================

# ─── Backend ─────────────────────────────────────────────────
PORT=3001

# ─── MQTT ────────────────────────────────────────────────────
MQTT_BROKER=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_MONITOR=labil_listrik_123/monitor
MQTT_TOPIC_CONTROL=labil_listrik_123/control/relay

# ─── Perangkat ───────────────────────────────────────────────
RELAY_COUNT=4
POWER_LIMIT_WATT=1000

# ─── Autentikasi ─────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_TOKEN=labil-token-123

# ─── Database ────────────────────────────────────────────────
DB_PATH=./database.sqlite

# ─── Frontend (prefix VITE_ wajib) ──────────────────────────
# CATATAN: BACKEND_URL tidak diperlukan — selalu pakai URL relatif via Vite proxy
VITE_RELAY_COUNT=4
VITE_TARIF_PER_KWH=1444
VITE_APP_NAME=IoT Panel
VITE_APP_TITLE=Monitoring Listrik
